# ============================================================================
# VoltFlow environment
# ============================================================================
# Copy to .env and fill in real values. Never commit .env — it is gitignored.
#
# Supabase: Dashboard → Project Settings → Database → Connection string.
# Both URLs below use the SAME project ref, password and region; only the
# port differs. Copy them from the dashboard rather than hand-editing, since
# a wrong project ref fails with "Tenant or user not found".
#
# This file is for your DEV project — the one you seed. Production is a
# separate Supabase project whose connection strings live only in Vercel
# (Settings → Environment Variables, Production scope), never in a local file.
# ============================================================================

# --- Database ---------------------------------------------------------------

# Transaction pooler (port 6543). Used for all runtime queries.
# pgbouncer=true tells Prisma to disable prepared statements.
# connection_limit=1 is correct for serverless — each function gets one.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (port 5432). Used only by `prisma migrate` / `prisma db push`.
# DDL and prepared statements do not work through the transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# --- Auth -------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET="<random-32-byte-base64-string>"

# MUST match the origin the app is actually served from, or OAuth callbacks
# and redirects break. Local dev: http://localhost:3000
# Production: https://your-domain.com  (no trailing slash)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY every notification silently no-ops and is only logged.
# That includes the admin BOM email used for manual quote sourcing.

RESEND_API_KEY=""
EMAIL_FROM="VoltFlow <noreply@your-verified-domain.com>"

# Receives the full BOM whenever a project is saved, for manual quote sourcing.
ADMIN_EMAIL=""

# --- App --------------------------------------------------------------------
# Used to build absolute links inside outgoing emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
