// This is your Next.js NextAuth / Prisma schema foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime queries go through the transaction pooler (Supabase port 6543).
  // Serverless functions open many short-lived connections; without pooling
  // they exhaust Postgres connection limits under even modest traffic.
  url = env("DATABASE_URL")

  // Migrations need a real session — prepared statements and DDL do not work
  // through a transaction pooler. Session pooler (port 5432) or direct.
  directUrl = env("DIRECT_URL")
}

// =======================
// ENUMS
// =======================
enum Role {
  HOMEOWNER
  DEALER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionTier {
  FREEMIUM
  BASIC
  PRO
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
}

enum ProjectStatus {
  DRAFT
  ESTIMATED
  RFQ_SUBMITTED
  QUOTED
  CLOSED
}

enum QuoteRequestStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

// =======================
// CORE MODELS
// =======================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  password      String    // bcrypt hashed
  role          Role      @default(HOMEOWNER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dealerProfile DealerProfile?
  projects      Project[]
  quotes        Quote[]
  
  @@index([email])
  @@index([role])
}

model DealerProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName        String
  gstin              String?          @unique // Crucial for Phase 0 anti-fraud
  address            String
  city               String
  state              String
  pincode            String
  
  serviceAreas       String[]         // Array of serviceable pincodes
  brandsSold         String[]         // e.g., ["Polycab", "Finolex"]
  
  approvalStatus     ApprovalStatus   @default(PENDING)
  subscriptionTier   SubscriptionTier @default(FREEMIUM)

  // quotesThisMonth was removed here. A stored counter named for a calendar
  // period needs something to reset it, and this project has no cron, queue or
  // worker to do that — so it only ever counted upward, and the first tier
  // limit built on it would have put every dealer permanently over quota.
  // Derive it instead: getDealerQuoteCountThisMonth() in features/quotes.

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([city])
  @@index([approvalStatus])
}

model Project {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  projectName      String
  projectType      ProjectType      @default(RESIDENTIAL)
  status           ProjectStatus    @default(DRAFT)
  
  // The shape of this JSON MUST be validated by Zod on the backend
  inputData        Json             
  bomData          Json?            
  totalEstimate    Float?

  // The copper index this estimate was priced against, so a saved BOQ can be
  // re-read at the rate it was generated with rather than today's. Optional:
  // projects saved before snapshots existed have none. Only ever set
  // server-side, when a project is created or when a draft is re-priced to be
  // sent for quotes — never taken from a payload, or a caller could pin a
  // quote to a stale, cheaper copper rate.
  priceSnapshotId  String?
  priceSnapshot    PriceSnapshot?   @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)

  quoteRequest     QuoteRequest?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([priceSnapshotId])
}

model QuoteRequest {
  id               String             @id @default(cuid())
  projectId        String             @unique
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // DRAFT until sent to dealers, OPEN until the buyer accepts a quote, then
  // CLOSED. Being full or past expiresAt is derived, never stored: either
  // stops new bids, neither ends the buyer's choice (features/quotes/validity).
  status           QuoteRequestStatus @default(OPEN)
  visibilityCity   String             // Essential for localizing dealer leads
  visibilityPincode String?
  maxQuotes        Int                @default(5)
  quoteCount       Int                @default(0)
  
  quotes           Quote[]

  // When dealers could first see the request, which they read as its issue
  // date. Set on creation, and reset when a saved draft is sent.
  createdAt        DateTime           @default(now())
  expiresAt        DateTime?

  @@index([status])
  @@index([visibilityCity])
}

model Quote {
  id               String       @id @default(cuid())
  quoteRequestId   String
  quoteRequest     QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  dealerId         String
  dealer           User         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  clientRequestId  String       @unique
  
  totalPrice       Float
  brandOffered     String       // Prevent "race to the bottom" unbranded materials

  // Insulation grade quoted: FR | FRLS | ZHFR. Two dealers quoting the same
  // brand at different grades are not quoting the same job, so price alone is
  // a misleading comparison without this. Stored as the short code, not the
  // display label — see src/features/quotes/wireGrade.ts.
  //
  // Nullable because quotes predate the field; a String rather than an enum so
  // a new grade does not need a migration to be accepted. The allowed values
  // are enforced in submitQuoteSchema.
  wireGrade        String?

  deliveryDays     Int?
  details          String?      @db.Text
  status           QuoteStatus  @default(SUBMITTED)

  // Buyer-side "Remove": drops the row from the comparison matrix without
  // deleting it. The quote still counts toward the RFQ's quoteCount, still
  // belongs to the dealer's history, and still appears in admin analytics.
  // Hiding is a view preference, never a deletion.
  isHidden         Boolean      @default(false)

  createdAt        DateTime     @default(now())
  // Always set by the server (72 hours, see features/quotes/validity.ts) and
  // never accepted from a payload. Nullable only for quotes that predate it.
  validUntil       DateTime?

  // Per-SKU pricing. totalPrice stays as the headline figure the matrix sorts
  // on; lines let a buyer check that the brand and grade quoted are the ones
  // delivered. Quotes submitted before lines existed have none.
  quoteLines       QuoteLine[]

  @@index([dealerId])
  @@index([quoteRequestId])
  // One quote per dealer per RFQ, enforced by the database and not only by the
  // check in submitQuoteTransaction: a double-click or a replayed request that
  // races past the check still cannot create a second row.
  @@unique([quoteRequestId, dealerId])
}

model QuoteLine {
  id                   String   @id @default(cuid())
  quoteId              String
  quote                Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  componentDescription String   // e.g. "Polycab 1.5 sq mm FR 90 m"
  quantity             Int
  unitPrice            Float
  totalPrice           Float

  @@index([quoteId])
}

// A copper index reading. Rows are append-only history: a new rate is a new
// row with a later effectiveDate, never an update, so any project can be
// re-priced exactly as it was quoted. onDelete: Restrict on Project keeps a
// snapshot from being removed while a project still points at it.
model PriceSnapshot {
  id             String    @id @default(cuid())
  baseCopperRate Float     // ₹ per kg; convert an LME $/t reading before storing
  effectiveDate  DateTime  // when the rate applied in the market
  source         String    // e.g. "MCX" or "LME"
  createdAt      DateTime  @default(now()) // when it was recorded

  projects       Project[]

  @@index([effectiveDate])
}

model RegulatoryPhasePolicy {
  id                     String   @id @default(cuid())
  cityKey                String   @unique
  connectedLoadThresholdKw Float
  isActive               Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
}

model PriceIndex {
  id               String   @id @default(cuid())
  wireType         String   // e.g., "1.5 sq mm FR PVC"
  brand            String   // e.g., "Polycab"
  unitPrice        Float    // Per meter
  unit             String   @default("meter")
  
  effectiveDate    DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([wireType, brand])
  @@index([wireType])
}

// Emails left on /snap-to-bom to hear when it launches. Stored lowercased, so
// the unique index also catches "Foo@x.com" after "foo@x.com". RLS is on with
// no policies (see the migration): only the app, through Prisma, can read or
// write it.
model WaitlistSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
